# Copy this file to .env.local and fill in your values
# DO NOT commit .env.local — it contains secrets

# Supabase — Get these from: supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin dashboard login (/admin). Use long random values.
ADMIN_PASSWORD=choose-a-long-random-password
ADMIN_SESSION_SECRET=choose-a-different-long-random-string

# Only needed for the document scripts in scripts/ (embedding and extraction).
# The deployed app does not use them.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
